{
  "expo": {
    "name": "EV ChargeOps",
    "slug": "ev-charge-ops",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "evchargeops",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "io.softmoon.evchargeops",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "O EV ChargeOps usa a câmera para ler os dados do cartão no pagamento das recargas."
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:app.evchargeops.com.br"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.softmoon.evchargeops",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.evchargeops.com.br",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "app.evchargeops.com.br",
              "pathPrefix": "/login/email"
            },
            {
              "scheme": "https",
              "host": "app.evchargeops.com.br",
              "pathPrefix": "/verify-email"
            },
            {
              "scheme": "https",
              "host": "app.evchargeops.com.br",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.396604379277-uf8a1ns9befs1k2f8ts3udap10q5mka0"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O EV ChargeOps usa sua localização para mostrar os pontos de recarga mais próximos.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "O EV ChargeOps usa os sensores de movimento do aparelho para melhorar a precisão da sua localização ao buscar pontos de recarga.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#E8121F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb5e32df-a17d-45f0-92b4-bea9a0ab76cb"
      }
    },
    "owner": "ev-charge-ops",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bb5e32df-a17d-45f0-92b4-bea9a0ab76cb"
    }
  }
}
